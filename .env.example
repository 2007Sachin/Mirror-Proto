# MIRROR Phase 1 backend. Copy to .env for local development (never commit .env).

# Server
PORT=8787

# Supabase (leave empty to run in memory mode). SUPABASE_SECRET_KEY is server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alias accepted: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# NVIDIA NIM (server-side only). Leave empty → memory-mode follow-ups + 503 on reflection.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Aliases accepted: NIM_API_KEY, NIM_BASE_URL, NIM_MODEL

# Phase 2 voice (server-side only). Empty SARVAM_API_KEY → mock STT/TTS.
# Checklist:
# 1. Create a Sarvam API key and set SARVAM_API_KEY in the server environment (never VITE_*).
# 2. Keep the defaults below unless Sarvam docs require a different supported model/voice.
# 3. Restart the realtime gateway so /health reports voice.provider=sarvam.
# 4. Confirm GET /integration-status.voice.live is true and the browser never receives the key.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_TRANSPORT=realtime
SARVAM_STT_REALTIME_MODEL=saaras:v3-realtime
SARVAM_STT_REALTIME_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_STT_ENDPOINTING=manual
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LANGUAGE=en-IN
SARVAM_SPEAKER=shubh
VITE_VOICE_WS_URL=ws://localhost:3000/ws/voice
