# MIRROR Phase 1 backend. Copy to .env for local development (never commit .env).

# Server
PORT=8787

# Supabase auth + data. Needs SUPABASE_URL and SUPABASE_ANON_KEY (the anon key is public by design).
# Every request runs as the signed-in user, so row level security applies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service key: tests and admin scripts only. The running app never uses it. Alias: SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the site (auth redirects).
# Supabase Dashboard > Authentication > URL Configuration: set Site URL to SITE_URL, and add the redirect URL
# http://localhost:3000/auth/callback (and your production https://<host>/auth/callback).
# Authentication > Providers: Email enabled (magic link). Sessions live in httpOnly cookies set by this server.
SITE_URL=http://localhost:3000
# AUTH_GOOGLE=1 shows "Continue with Google" (enable the provider in Supabase first).
AUTH_GOOGLE=
# DEMO_MODE=1: no sign-in, one shared 'dev' user, in-memory data. Local demos only, never production.
DEMO_MODE=
# Boot fails if DEMO_MODE=1 with NODE_ENV=production or an https SITE_URL.

# TRUST_PROXY=1: trust X-Forwarded-For for per-IP limits. Only behind a proxy that sets it.
TRUST_PROXY=
# VOICE_LOCAL_ONLY=1: voice websocket accepts loopback clients only (default: any, Origin+session checked).
VOICE_LOCAL_ONLY=

# NVIDIA NIM (server-side only). Leave empty → memory-mode follow-ups + 503 on reflection.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Aliases accepted: NIM_API_KEY, NIM_BASE_URL, NIM_MODEL

# Phase 2 voice (server-side only). Empty SARVAM_API_KEY → voice is off and the learner types.
# STT_PROVIDER: sarvam (used when SARVAM_API_KEY is set) | mock | none. `mock` works ONLY with VOICE_MOCK_STT=1
# and never invents an answer (tests/dev smoke only). With neither, STT_PROVIDER resolves to none.
STT_PROVIDER=
VOICE_MOCK_STT=
# Checklist:
# 1. Create a Sarvam API key and set SARVAM_API_KEY in the server environment (never VITE_*).
# 2. Keep the defaults below unless Sarvam docs require a different supported model/voice.
# 3. Restart the realtime gateway so /health reports voice.provider=sarvam.
# 4. Confirm GET /integration-status.voice.live is true and the browser never receives the key.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_TRANSPORT=realtime
SARVAM_STT_REALTIME_MODEL=saaras:v3-realtime
SARVAM_STT_REALTIME_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_STT_ENDPOINTING=manual
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LANGUAGE=en-IN
SARVAM_SPEAKER=shubh
VITE_VOICE_WS_URL=ws://localhost:3000/ws/voice

# Migration 0009_variable_length_interviews.sql is applied; set this to 1 so screens may use variable length.
SCREEN_DB_READY=1

# The Room: Interviewer model call deadline in ms (500 to 2000) and max model calls per interview.
INTERVIEWER_DEADLINE_MS=
INTERVIEW_CALL_BUDGET=
# Live-call nudges: VOICE_NUDGE=shadow (log only, default) | on | off. Thresholds in ms; the first question waits 15000.
VOICE_NUDGE=
VOICE_NUDGE_SILENCE_MS=
VOICE_NUDGE_SECOND_MS=
VOICE_RAMBLE_MS=
VOICE_RAMBLE_WORDS=
