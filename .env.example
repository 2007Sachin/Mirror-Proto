# MIRROR Phase 1 backend. Copy to .env for local development (never commit .env).

# Server
PORT=8787

# Supabase (leave empty to run in memory mode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# NVIDIA NIM (reflection provider; leave empty → /reflect returns 503)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct

# Phase 2 (voice) — placeholders, not used yet
SARVAM_API_KEY=
VITE_VOICE_WS_URL=ws://localhost:3000/ws/voice
